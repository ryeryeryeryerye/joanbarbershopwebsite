{
  "name": "barbershop-monorepo",
  "version": "1.0.0",
  "description": "BARBERSHOP – Website quản lý và đặt lịch cắt tóc trực tuyến",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "pnpm --parallel --filter barbershop-frontend --filter barbershop-backend dev",
    "dev:frontend": "pnpm --filter barbershop-frontend dev",
    "dev:backend": "pnpm --filter barbershop-backend dev",
    "build:frontend": "pnpm --filter barbershop-frontend build",
    "build:backend": "pnpm --filter barbershop-backend build",
    "lint:frontend": "pnpm --filter barbershop-frontend lint",
    "lint:backend": "pnpm --filter barbershop-backend lint",
    "seed:backend": "pnpm --filter barbershop-backend seed"
  },
  "keywords": [
    "barbershop",
    "booking",
    "react",
    "express",
    "typescript",
    "monorepo"
  ],
  "author": "",
  "license": "ISC"
}

